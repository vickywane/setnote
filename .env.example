# Copy to .env.local for local development. Values here are bundled into the app in
# plain text, so never put secrets in EXPO_PUBLIC_* variables.
#
# For EAS builds, set these per environment (development / preview / production) with
# `npx eas-cli@latest env:create` instead of committing them.

# Supabase project (VIC-57). Find both in the dashboard under Project Settings > API Keys,
# or with `supabase projects api-keys`. The publishable key is safe to bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database password, only used by the Supabase CLI (`supabase link`, `supabase db push`).
# Never prefix it with EXPO_PUBLIC_.
# SUPABASE_DB_PASSWORD=


# Presage SmartSpectra API key for the post-workout recovery check (iOS only). Get one at
# https://physiology.presagetech.com. Leave empty to hide the check.
EXPO_PUBLIC_PRESAGE_API_KEY=
